// =============================================================================
// DealHunter — Prisma Database Schema
// =============================================================================
// PostgreSQL schema for AI-Powered Product Deal Comparison Platform
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum IdentifierType {
  GTIN
  EAN
  UPC
  MPN
  ISBN
  ASIN
}

enum OfferAvailability {
  IN_STOCK
  OUT_OF_STOCK
  LIMITED_STOCK
  UNKNOWN
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  name         String?       @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  wishlistItems WishlistItem[]
  priceAlerts   PriceAlert[]
  searchQueries SearchQuery[]

  @@map("users")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(100)
  parentId  String?    @map("parent_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  brand       String?  @db.VarChar(100)
  name        String   @db.VarChar(500)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@index([brand])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  name       String   @db.VarChar(500)
  storage    String?  @db.VarChar(50)
  ram        String?  @db.VarChar(50)
  color      String?  @db.VarChar(100)
  size       String?  @db.VarChar(50)
  attributes Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  identifiers   ProductIdentifier[]
  offers        ProductOffer[]
  wishlistItems WishlistItem[]
  priceAlerts   PriceAlert[]

  @@index([productId])
  @@map("product_variants")
}

model ProductIdentifier {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  type      IdentifierType
  value     String         @db.VarChar(100)
  source    String?        @db.VarChar(100)
  createdAt DateTime       @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([value])
  @@map("product_identifiers")
}

model Merchant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  baseUrl   String?  @map("base_url") @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  offers  ProductOffer[]
  sellers Seller[]

  @@map("merchants")
}

model Seller {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @map("merchant_id") @db.Uuid
  externalId  String?  @map("external_id") @db.VarChar(200)
  name        String   @db.VarChar(300)
  rating      Decimal? @db.Decimal(3, 2)
  reviewCount Int      @default(0) @map("review_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  merchant Merchant       @relation(fields: [merchantId], references: [id])
  offers   ProductOffer[]

  @@index([merchantId])
  @@map("sellers")
}

model ProductOffer {
  id                String            @id @default(uuid()) @db.Uuid
  variantId         String            @map("variant_id") @db.Uuid
  merchantId        String            @map("merchant_id") @db.Uuid
  sellerId          String?           @map("seller_id") @db.Uuid
  externalProductId String            @map("external_product_id") @db.VarChar(500)
  productUrl        String            @map("product_url") @db.VarChar(1000)
  listedPrice       Decimal           @map("listed_price") @db.Decimal(12, 2)
  discountedPrice   Decimal           @map("discounted_price") @db.Decimal(12, 2)
  discountPercent   Decimal?          @map("discount_percent") @db.Decimal(5, 2)
  shippingCost      Decimal           @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  isFreeDelivery    Boolean           @default(false) @map("is_free_delivery")
  availability      OfferAvailability @default(IN_STOCK)
  productRating     Decimal?          @map("product_rating") @db.Decimal(3, 2)
  reviewCount       Int               @default(0) @map("review_count")
  deliveryDays      Int?              @map("delivery_days") @db.SmallInt
  returnPolicyDays  Int               @default(0) @map("return_policy_days") @db.SmallInt
  fetchedAt         DateTime          @default(now()) @map("fetched_at")
  expiresAt         DateTime?         @map("expires_at")
  rawData           Json?             @map("raw_data") @db.JsonB

  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  merchant     Merchant       @relation(fields: [merchantId], references: [id])
  seller       Seller?        @relation(fields: [sellerId], references: [id])
  priceHistory PriceHistory[]
  dealScore    DealScore?

  @@index([variantId])
  @@index([merchantId])
  @@index([fetchedAt])
  @@index([discountedPrice])
  @@map("product_offers")
}

model PriceHistory {
  id           String            @id @default(uuid()) @db.Uuid
  offerId      String            @map("offer_id") @db.Uuid
  price        Decimal           @db.Decimal(12, 2)
  shippingCost Decimal           @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  availability OfferAvailability @default(IN_STOCK)
  recordedAt   DateTime          @default(now()) @map("recorded_at")

  offer ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, recordedAt])
  @@map("price_history")
}

model DealScore {
  id            String   @id @default(uuid()) @db.Uuid
  offerId       String   @unique @map("offer_id") @db.Uuid
  score         Decimal  @db.Decimal(5, 2)
  trueCost      Decimal  @map("true_cost") @db.Decimal(12, 2)
  priceScore    Decimal  @map("price_score") @db.Decimal(5, 4)
  sellerScore   Decimal  @map("seller_score") @db.Decimal(5, 4)
  ratingScore   Decimal  @map("rating_score") @db.Decimal(5, 4)
  deliveryScore Decimal  @map("delivery_score") @db.Decimal(5, 4)
  returnScore   Decimal  @map("return_score") @db.Decimal(5, 4)
  historyScore  Decimal  @map("history_score") @db.Decimal(5, 4)
  explanation   Json?    @db.JsonB
  calculatedAt  DateTime @default(now()) @map("calculated_at")

  offer ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([score(sort: Desc)])
  @@map("deal_scores")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@map("wishlist_items")
}

model PriceAlert {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  targetPrice Decimal  @map("target_price") @db.Decimal(12, 2)
  isTriggered Boolean  @default(false) @map("is_triggered")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("price_alerts")
}

model SearchQuery {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  query       String   @db.Text
  resultCount Int?     @map("result_count")
  responseMs  Int?     @map("response_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("search_queries")
}
