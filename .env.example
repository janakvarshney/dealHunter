# =============================================================================
# DealHunter — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development                      # "development" | "production" | "test"
APP_NAME=DealHunter
APP_VERSION=0.1.0
PORT=4000                                 # Backend server port

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://dealhunter_user:your_password@localhost:5432/dealhunter_db
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For production on Render: use the connection string from Render dashboard

# --- Redis ---
REDIS_URL=redis://localhost:6379
# For production: use Render Redis or Upstash connection string

# --- JWT Authentication ---
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_64_chars
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=7d                         # Token expiry: e.g. "7d", "24h", "1h"
JWT_COOKIE_NAME=dh_access_token          # Name of the httpOnly cookie

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
# Get your free key at: https://aistudio.google.com
# AI features will be disabled if this key is missing or invalid
GEMINI_MODEL=gemini-1.5-flash            # Or "gemini-1.5-pro" for higher quality

# --- CORS ---
FRONTEND_URL=http://localhost:5173        # Vite dev server default
# Production: https://your-app.vercel.app

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000              # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100             # Max requests per window per IP
AI_RATE_LIMIT_MAX=20                    # Lower limit for AI endpoints (they cost money)

# --- Caching ---
CACHE_TTL_SEARCH=300                     # Search results cache TTL in seconds (5 min)
CACHE_TTL_PRODUCT=600                    # Product detail cache TTL in seconds (10 min)
CACHE_TTL_OFFERS=180                     # Offers cache TTL in seconds (3 min)

# --- Product Data Refresh ---
PRICE_REFRESH_INTERVAL_MINUTES=30       # How often background job refreshes prices
CONNECTOR_TIMEOUT_MS=5000               # Max ms to wait for a connector response

# --- Logging ---
LOG_LEVEL=info                           # "debug" | "info" | "warn" | "error"
LOG_FORMAT=pretty                        # "pretty" (dev) | "json" (production)

# --- Feature Flags ---
ENABLE_AI_SEARCH=true                    # Set to false to disable AI features entirely
ENABLE_PRICE_HISTORY=true               # Enable price history tracking
ENABLE_WISHLISTS=true                   # Enable wishlist feature (requires auth)

# --- Connector API Keys (for future real integrations) ---
# These are NOT used in MVP (mock data). Scaffold only.
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=
# FLIPKART_AFFILIATE_ID=
# FLIPKART_AFFILIATE_TOKEN=
